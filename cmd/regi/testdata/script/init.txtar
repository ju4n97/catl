# Scaffold catalog in a new directory
exec regi init --name app-rules --collection rules catalog-a
stdout 'create catalog-a/regi.toml'
stdout 'create catalog-a/schemas/rules.json'
stdout 'create catalog-a/.gitattributes'
exists catalog-a/regi.toml
exists catalog-a/schemas/rules.json
exists catalog-a/.gitattributes
cmp catalog-a/regi.toml expected-catalog-regi.toml

# Refuse to re-initialize an existing catalog
! exec regi init -C catalog-a
stderr 'regi: regi\.toml already exists'

# Initialize an empty workspace root
exec regi init --workspace platform-ws
stdout 'create platform-ws/regi.toml'
stdout 'create platform-ws/.gitattributes'
! exists platform-ws/schemas
cmp platform-ws/regi.toml expected-workspace-regi.toml

# Append member when initializing inside an existing workspace
exec regi init -C platform-ws --name billing --collection invoices billing-catalog
stdout 'create platform-ws/billing-catalog/regi.toml'
stdout 'update platform-ws/regi.toml'
cmp platform-ws/regi.toml expected-updated-workspace-regi.toml

-- expected-catalog-regi.toml --
[catalog]
name = "app-rules"

[collections.rules]
schema = "schemas/rules.json"

-- expected-workspace-regi.toml --
[workspace]
members = []

-- expected-updated-workspace-regi.toml --
[workspace]
members = [
  "billing-catalog",
]