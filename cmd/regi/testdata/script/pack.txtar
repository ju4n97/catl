# Build deterministic tar archive
exec regi pack -o package.tar
exists package.tar

# Verify exclusions in unpacked archive
mkdir -p unpacked
cd unpacked
exec tar -xf ../package.tar
exists regi.toml
exists schemas/rules.json
exists rules/auth.yaml
! exists regi.lock
! exists index.json
! exists .regi-index.json
! exists .gitattributes
! exists .hidden-draft.yaml
cd ..

# Verify bit-for-bit packaging determinism
exec regi pack -o package2.tar
cmp package.tar package2.tar

-- regi.toml --
[catalog]
name = "platform-rules"

[collections.rules]
schema = "schemas/rules.json"

-- regi.lock --
version = 1

-- .gitattributes --
* text=auto eol=lf

-- .hidden-draft.yaml --
title: Hidden

-- schemas/rules.json --
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object"
}

-- rules/auth.yaml --
enabled: true