# Scaffold catalog in a new directory
exec catl init --name app-rules --collection rules catalog-a
stdout 'create catalog-a/catl.toml'
stdout 'create catalog-a/schemas/rules.json'
stdout 'create catalog-a/.gitattributes'
exists catalog-a/catl.toml
exists catalog-a/schemas/rules.json
exists catalog-a/.gitattributes
cmp catalog-a/catl.toml expected-catalog-catl.toml

# Refuse to re-initialize an existing catalog
! exec catl init -C catalog-a
stderr 'catl: catl\.toml already exists'

# Initialize an empty workspace root
exec catl init --workspace platform-ws
stdout 'create platform-ws/catl.toml'
stdout 'create platform-ws/.gitattributes'
! exists platform-ws/schemas
cmp platform-ws/catl.toml expected-workspace-catl.toml

# Append member when initializing inside an existing workspace
exec catl init -C platform-ws --name billing --collection invoices billing-catalog
stdout 'create billing-catalog/catl.toml'
stdout 'update catl.toml'
cmp platform-ws/catl.toml expected-updated-workspace-catl.toml

-- expected-catalog-catl.toml --
#:schema https://ju4n97.github.io/catl/schema/v1/catl.schema.json

[catalog]
name = "app-rules"

[collections.rules]
schema = "schemas/rules.json"

-- expected-workspace-catl.toml --
#:schema https://ju4n97.github.io/catl/schema/v1/catl.schema.json

[workspace]
members = []

-- expected-updated-workspace-catl.toml --
#:schema https://ju4n97.github.io/catl/schema/v1/catl.schema.json

[workspace]
members = [
  "billing-catalog",
]