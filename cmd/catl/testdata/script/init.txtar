# Scaffold catalog in a new directory
exec catl init --name app-rules --collection rules catalog-a
stdout 'create catalog-a/catl.toml'
stdout 'create catalog-a/schemas/rules.json'
stdout 'create catalog-a/.gitattributes'
exists catalog-a/catl.toml
exists catalog-a/schemas/rules.json
exists catalog-a/.gitattributes
cmp catalog-a/catl.toml expected-catalog-catl.toml

# Refuse to re-initialize an existing catalog
! exec catl init -C catalog-a
stderr 'catl\.toml already exists'

# Reject invalid catalog and collection identifiers
! exec catl init --name Invalid_Name bad-catalog
stderr 'invalid identifier'
! exec catl init --name valid-name --collection Invalid_Name bad-collection
stderr 'invalid identifier'

-- expected-catalog-catl.toml --
#:schema https://raw.githubusercontent.com/ju4n97/catl/refs/heads/main/schema/catl.schema.json

[catalog]
name = "app-rules"

[collections.rules]
schema = "schemas/rules.json"
