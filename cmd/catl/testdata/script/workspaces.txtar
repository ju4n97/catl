# Validating workspace root validates all members
exec catl check
! stdout .
! stderr .

# List entities across all workspace members
exec catl list
stdout '^agents\tassistants\.triage\tassistants/agents/triage/manifest\.yaml$'
stdout '^protocols\tclinical\.emergency\tclinical/protocols/emergency\.yaml$'

# Validate specific member from workspace root
exec catl -m clinical check
! stdout .
! stderr .

# Upward discovery climbs from member to root lockfile
cd clinical
exec catl check
! stdout .
! stderr .

# Member resolves local path dependency
exec catl resolve protocols clinical.emergency
stdout 'clinical/protocols/emergency\.yaml'
cd ..

-- catl.toml --
[workspace]
members = [
  "assistants",
  "clinical",
]

-- clinical/catl.toml --
[catalog]
name = "clinical"

[collections.protocols]

-- clinical/protocols/emergency.yaml --
title: Emergency Protocol

-- assistants/catl.toml --
[catalog]
name = "assistants"

[dependencies]
clinical = { path = "../clinical" }

[collections.agents]

-- assistants/agents/triage/manifest.yaml --
name: Triage Agent
protocol: clinical.emergency