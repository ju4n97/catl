# Populate cache directory with dummy entries
mkdir -p $CATL_CACHE_DIR/git/acme-infra
mkdir -p $CATL_CACHE_DIR/archives
cp dummy.txt $CATL_CACHE_DIR/archives/policies-v1.tar.gz

# Populate local catalog with vendored dependencies
mkdir -p my-catalog/.catl/vendor/shared-infra
cp dummy.txt my-catalog/.catl/vendor/shared-infra/manifest.yaml

# Purge cache
exec catl clean
! stdout .
! stderr .

# Cache must be completely removed
! exists $CATL_CACHE_DIR/git/acme-infra
! exists $CATL_CACHE_DIR/archives/policies-v1.tar.gz

# Local vendored directory must remain untouched
exists my-catalog/.catl/vendor/shared-infra/manifest.yaml

-- dummy.txt --
test-data