{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ju4n97.github.io/catl/schema/v1/catl.schema.json",
    "title": "catl.toml",
    "description": "Validation schema for catl catalog and workspace configuration files.",
    "type": "object",
    "properties": {
        "catalog": { "$ref": "#/$defs/catalog" },
        "workspace": { "$ref": "#/$defs/workspace" },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "collections": { "$ref": "#/$defs/collections" }
    },
    "additionalProperties": false,
    "if": {
        "required": ["workspace"]
    },
    "then": {
        "not": {
            "anyOf": [
                { "required": ["catalog"] },
                { "required": ["collections"] },
                { "required": ["dependencies"] }
            ]
        }
    },
    "else": {
        "required": ["catalog", "collections"]
    },
    "$defs": {
        "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 63
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "relpath": {
            "type": "string",
            "pattern": "^[^/.](.*[^/])?$"
        },
        "anypath": {
            "type": "string",
            "pattern": "^[^/:].*$"
        },
        "catalog": {
            "type": "object",
            "properties": {
                "name": { "$ref": "#/$defs/name" }
            },
            "required": ["name"],
            "additionalProperties": false
        },
        "workspace": {
            "type": "object",
            "properties": {
                "members": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/relpath" },
                    "uniqueItems": true
                }
            },
            "required": ["members"],
            "additionalProperties": false
        },
        "dependencies": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/name" },
            "additionalProperties": { "$ref": "#/$defs/dependency" }
        },
        "dependency": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "git": {
                            "type": "string",
                            "pattern": "^(https|ssh)://.+"
                        },
                        "tag": { "type": "string", "minLength": 1 },
                        "branch": { "type": "string", "minLength": 1 },
                        "rev": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{40}$"
                        },
                        "subdir": { "$ref": "#/$defs/relpath" }
                    },
                    "required": ["git"],
                    "oneOf": [
                        { "required": ["tag"] },
                        { "required": ["branch"] },
                        { "required": ["rev"] }
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "url": {
                            "type": "string",
                            "pattern": "^https://.+"
                        },
                        "digest": { "$ref": "#/$defs/digest" }
                    },
                    "required": ["url"],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "path": { "$ref": "#/$defs/anypath" }
                    },
                    "required": ["path"],
                    "additionalProperties": false
                }
            ]
        },
        "collections": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/name" },
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "schema": { "$ref": "#/$defs/relpath" },
                    "dir": { "$ref": "#/$defs/relpath" }
                },
                "additionalProperties": false
            }
        }
    }
}
